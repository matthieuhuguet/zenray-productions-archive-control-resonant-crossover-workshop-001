from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
import json

ROOT = Path(__file__).resolve().parents[1] / 'Status'

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        name = {'/': 'index.html', '/state.json': 'state.json'}.get(self.path.split('?')[0])
        if not name or not (ROOT / name).exists():
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header('Content-Type', 'application/json' if name.endswith('.json') else 'text/html; charset=utf-8')
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write((ROOT / name).read_bytes())
    def log_message(self, *args):
        pass

server = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
url = f'http://127.0.0.1:{server.server_port}/'
(ROOT / 'Server.json').write_text(json.dumps({'url': url}))
print(url, flush=True)
server.serve_forever()
