#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <dlfcn.h>

int main(int argc, char **argv) {
    if (argc != 3) return 64;
    void *library = dlopen(argv[1], RTLD_NOW | RTLD_LOCAL);
    if (!library) { fprintf(stderr, "%s\n", dlerror()); return 65; }
    void *(*create_compiler)(void) = dlsym(library, "IRCompilerCreate");
    void *(*create_object)(const uint8_t *, size_t, int) = dlsym(library, "IRObjectCreateFromDXIL");
    void *(*compile_object)(void *, const char *, void *, void **) = dlsym(library, "IRCompilerAllocCompileAndLink");
    void (*validate)(void *, unsigned) = dlsym(library, "IRCompilerSetValidationFlags");
    unsigned (*error_code)(void *) = dlsym(library, "IRErrorGetCode");
    void (*destroy_object)(void *) = dlsym(library, "IRObjectDestroy");
    void (*destroy_compiler)(void *) = dlsym(library, "IRCompilerDestroy");
    void (*destroy_error)(void *) = dlsym(library, "IRErrorDestroy");
    if (!create_compiler || !create_object || !compile_object || !validate || !error_code ||
        !destroy_object || !destroy_compiler || !destroy_error) return 66;
    FILE *file = fopen(argv[2], "rb"); if (!file) return 67;
    fseek(file, 0, SEEK_END); long length = ftell(file); rewind(file);
    if (length <= 0) return 68;
    uint8_t *data = malloc((size_t)length);
    if (!data || fread(data, 1, (size_t)length, file) != (size_t)length) return 69;
    fclose(file);
    void *input = create_object(data, (size_t)length, 0);
    if (!input) { puts("{\"parsed\":false}"); free(data); return 2; }
    void *compiler = create_compiler(), *error = NULL;
    validate(compiler, 4);
    void *output = compile_object(compiler, NULL, input, &error);
    printf("{\"parsed\":true,\"compiled\":%s,\"errorCode\":%u}\n",
        output ? "true" : "false", error ? error_code(error) : 0);
    if (output) destroy_object(output);
    if (error) destroy_error(error);
    destroy_object(input); destroy_compiler(compiler); free(data);
    return output ? 0 : 3;
}
