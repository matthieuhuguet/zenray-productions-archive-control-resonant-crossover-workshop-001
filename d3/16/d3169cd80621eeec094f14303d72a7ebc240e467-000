# Build ConversationSummary.md: hand-written narrative plus an auto-generated table of every human prompt.
# FR : construit le résumé, récit rédigé à la main plus tableau automatique de tous les prompts humains.
import os, re
root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
tr = open(os.path.join(root, 'ConversationTranscript.md')).read()
blocks = re.findall(r'### PROMPT (\d+) \(([^)]*)\)\n\n(.*?)(?=\n### |\n## Fichier|\Z)', tr, flags=re.S)
rows = []
for n, when, body in blocks:
    body = body.strip()
    if '## My request:' in body: body = body.split('## My request:', 1)[1]
    body = re.sub(r'<image.*?</image>', '[capture jointe]', body, flags=re.S)
    body = re.sub(r'<send_user_message_question_reply>.*?</send_user_message_question_reply>', '[réponse à une question posée par Codex : « Le jeu ne démarre pas »]', body, flags=re.S)
    body = re.sub(r'\[IMAGE \d+\]', '', body)
    body = re.sub(r'\s+', ' ', body).strip().replace('|', '/')
    if len(body) > 150: body = body[:147].rstrip() + '...'
    day, hour = when.split(', ')
    rows.append(f'| {n} | {day[:2].strip()} oct., {hour[:5]} | {body or "[capture jointe seule]"} |')
table = '\n'.join(rows)

doc = open(os.path.join(root, 'Scripts', 'SummaryTemplate.md')).read().replace('{{PROMPT_TABLE}}', table)
open(os.path.join(root, 'ConversationSummary.md'), 'w').write(doc)
print(len(doc), 'chars', len(rows), 'prompts')
